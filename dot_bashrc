# .bashrc

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

. "$HOME/.config/shell/functions"
. "$HOME/.config/shell/alias"

PS1="\w $(chk_current_sh bash)% "
eval "$(direnv hook bash)"

. "$HOME/.local/share/../bin/env"

# >>> conda initialize >>>
# !! Contents within this block are managed by 'conda init' !!
__conda_setup="$('/home/andry/miniforge3/bin/conda' 'shell.bash' 'hook' 2> /dev/null)"
if [ $? -eq 0 ]; then
    eval "$__conda_setup"
else
    if [ -f "/home/andry/miniforge3/etc/profile.d/conda.sh" ]; then
        . "/home/andry/miniforge3/etc/profile.d/conda.sh"
    else
        export PATH="/home/andry/miniforge3/bin:$PATH"
    fi
fi
unset __conda_setup
# <<< conda initialize <<<

